static func chatter_pool(payment: String, arms_level: int, insufficient: bool, context: String="") -> Array:
 if context=="plate_self_block": return PLATE_SELF_BROWSE
 if not insufficient: return BROWSE
 if payment=="flask": return INSUFFICIENT_FLASK
 return INSUFFICIENT_SELF_FREE if arms_level==0 else INSUFFICIENT_SELF_BOUND

static func performance(method: String, variant: String="") -> Dictionary:
 var source=PLATE_RELEASE_PERFORMANCES if variant=="plate_release" else PERFORMANCES
 return source.get(method,{}).duplicate(true)
