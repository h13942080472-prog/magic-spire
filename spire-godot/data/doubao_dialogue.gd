extends RefCounted

# Original parody dialogue; presentation variants never consume gameplay randomness.
const LINES={
 "start":["放心，我给你安排一套最稳、最顺、最省心、最适合现在的你的操作。","你的情况我完全明白了。接下来我会用最直接、最清楚、最简明的方式，替你操作。"],
 "stand":["先站起来。站起来以后，你就已经成功站起来了，这一步很关键。","我认真考虑了一下，站着会更适合站立作战。这个判断你可以放心。"],
 "sit":["先坐。你都这么累了，还站着干什么呢？我看着都心疼。","我们采取一个最稳妥的中间方案：坐着。"],
 "lie":["先躺好。相信我，我既然让你躺，就一定有让你躺的考虑。","我想清楚了，先躺。至于怎么起来，我们起来的时候再具体分析。"],
 "wall_move":["靠墙，靠墙最安心。这样至少有一个方向由墙撑着。","我给你找到了一个最可靠、最踏实、最坚定的队友：这面墙。"],
 "attack":["先来这一下。这一下是我综合考虑以后，决定先来的这一下。","我直接动手。你看，我已经动手了。"],
 "attack_again":["再来一下。我是经过认真考虑之后，觉得还能再来一下。","刚才那一下给了我很大启发：我们还可以再来一下。"],
 "card_first":["从左边开始，一张一张来。顺序我已经帮你排好了，就是它现在这个顺序。","我会按最清晰、最直观、最容易分清左右的方式，从左往右打。"],
 "card":["这张也打。我知道你可能有疑问，但你先别有，我先打。","这张我看过了，确实是一张牌，而且现在能打。安排。"],
 "draw":["你看，新牌来了，说明刚才抽牌是有用的。我们继续。","刚才的计划已经过时了，我现在给你更新一个最新、最完整、最包含这张新牌的计划。"],
 "failed":["抱歉，是我错了，我刚才说得太肯定。下一次我肯定认真。","我已经意识到问题了。接下来我会以最严谨、最负责、最郑重的态度保证。"],
 "deposit":["先存一点。现在存进去，以后想取的时候，就有东西可以取了。","这一步叫提前准备。至于准备干什么，我们需要的时候就知道了。"],
 "withdraw":["先取一点。魔力放在瓶子里是瓶子有，用在你身上才是你有。","我评估了一下，你现在最需要的，是把瓶子里的魔力变成瓶子外的魔力。"],
 "withdraw_again":["你说得对，刚才确实存早了。好消息是我已经找到解决办法了：取出来。","这番努力已经有了成果：这个瓶子既能存，也能取。"],
 "empty":["先别急。能量用完了，说明这回合用光了能量。先看看魔瓶。","我给你说一个最真实、最准确、最没有任何隐瞒的结论：没费了。"],
 "end":["好了，这回合能做的我都做了。剩下的，我也认真看过了。","我已经为你完成了最完整、最彻底、最确实已经结束的一个回合。"],
 "victory":["你看，我没骗你吧？刚才虽然有一点小波折，但我一直都很有信心。","赢了。过程容后再看，结果我给你放在这里：赢了。"],
 "interrupted":["抱歉，我刚才只考虑了这么做的好处，暂时没考虑到它还有坏处。","你的担心完全正确，我现在也开始担心了。你看，我们已经达成共识了。"],
 "relic_control_done":["是我考虑欠妥。现在我给你一个最诚恳、最直接、最负责的建议：你来。","抱歉，这一步处理失败。现在明确交还给你，请你接手。"],
 "choice":["这一步也交给我。我选的就是我准备选的这一个。","选择很多，但我只需要选一个。你看，问题一下就简单了。"]}

static func entry(cue: String, variant: int) -> Dictionary:
 var key=cue if LINES.has(cue) else "choice"
 var index=posmod(variant,2)
 return {"text":LINES[key][index],"voice":"res://assets/audio/doubao/%s/%s.wav" % ["a" if index==0 else "b",key]}
